{
  "name": "effortdex",
  "private": true,
  "type": "module",
  "description": "Local-only Pokémon EV training tracker built with native Web Components.",
  "scripts": {
    "dev": "node scripts/dev-server.mjs --port 59387 --no-reload",
    "dev:docker": "docker compose watch",
    "test": "node --test \"test/**/*.test.js\" \"test/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "typecheck": "tsc",
    "build": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3",
    "uuidv7": "^1.2.1"
  }
}
