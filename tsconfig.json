{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["lib/**/*.js", "lib/**/*.ts", "components/**/*.ts", "e2e/**/*.js", "e2e/**/*.ts", "playwright.config.ts"],
  "exclude": ["lib/vendor/**"]
}
