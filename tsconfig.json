{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["lib/**/*.js", "e2e/**/*.js", "components/**/*.js", "pages/**/*.js", "test/**/*.js", "app.js", "sw.js", "playwright.config.js"],
  "exclude": ["lib/vendor/**"]
}
